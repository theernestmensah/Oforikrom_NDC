---
/**
 * A photo, or (until a real photo is added) a Kente-patterned placeholder.
 * While running locally, placeholders show which photo is needed.
 */
import Icon from './Icon.astro';
import Kente from './Kente.astro';

interface Props {
  src?: string;
  alt: string;
  /** Describes the photo that should go here (shown only in local development). */
  hint: string;
  variant?: number;
  tone?: 'red' | 'green' | 'black';
  class?: string;
  eager?: boolean;
}

const { src, alt, hint, variant = 0, tone = 'black', class: className = '', eager = false } = Astro.props;
const toneClass = { red: 'bg-ndc-red', green: 'bg-ndc-green', black: 'bg-ndc-black' }[tone];
---

<div class={`relative overflow-hidden ${className}`}>
  {
    src ? (
      <img
        src={src}
        alt={alt}
        class="absolute inset-0 h-full w-full object-cover"
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
        fetchpriority={eager ? 'high' : undefined}
      />
    ) : (
      <div class={`absolute inset-0 ${toneClass}`} role="img" aria-label={alt}>
        <Kente variant={variant} direction="y" class="absolute inset-y-0 left-[8%] w-[13%]" />
        <Kente variant={variant + 1} direction="y" offset={40} class="absolute inset-y-0 left-[21%] w-[13%]" />
        <Kente variant={variant + 2} direction="y" offset={70} class="absolute inset-y-0 left-[34%] w-[6%]" />
        <Icon name="umbrella-simple-fill" class="absolute -bottom-[12%] -right-[8%] h-[70%] w-auto text-white/10" />
        {import.meta.env.DEV && (
          <span class="absolute bottom-3 left-3 right-3 rounded-lg bg-white/90 px-3 py-2 text-xs font-semibold text-ndc-black">
            Photo needed: {hint}
          </span>
        )}
      </div>
    )
  }
</div>
