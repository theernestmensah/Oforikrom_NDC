---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import Photo from './Photo.astro';

interface Props {
  post: CollectionEntry<'news'>;
  size?: 'feature' | 'compact';
  variant?: number;
}

const { post, size = 'compact', variant = 0 } = Astro.props;
const { title, date, excerpt, tag, image, imageAlt } = post.data;
const href = `/news/${post.id}`;
const dateLabel = date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const tones = ['red', 'green', 'black'] as const;
---

{
  size === 'feature' ? (
    <article class="group relative">
      <Photo
        src={image}
        alt={imageAlt ?? title}
        hint="news cover photo (landscape, 16:9)"
        tone={tones[variant % 3]}
        variant={variant}
        class="aspect-[16/9] rounded-box"
      />
      <div class="mt-6">
        <p class="text-sm text-muted">
          <span class="font-semibold text-accent-text">{tag}</span>
          <span class="mx-1.5" aria-hidden="true">/</span>
          <time datetime={date.toISOString()}>{dateLabel}</time>
        </p>
        <h3 class="mt-3 text-[clamp(1.6rem,2.6vw,2.15rem)] font-bold leading-tight">
          <a href={href} class="after:absolute after:inset-0 group-hover:text-accent-text">
            {title}
          </a>
        </h3>
        <p class="mt-3 max-w-[60ch] text-ink-2">{excerpt}</p>
      </div>
    </article>
  ) : (
    <article class="group relative flex gap-5">
      <div class="min-w-0 flex-1">
        <p class="text-sm text-muted">
          <span class="font-semibold text-accent-text">{tag}</span>
          <span class="mx-1.5" aria-hidden="true">/</span>
          <time datetime={date.toISOString()}>{dateLabel}</time>
        </p>
        <h3 class="mt-1.5 font-sans text-lg font-bold leading-snug tracking-normal">
          <a href={href} class="after:absolute after:inset-0 group-hover:text-accent-text">
            {title}
          </a>
        </h3>
        <p class="mt-1 line-clamp-2 text-[0.98rem] text-ink-2">{excerpt}</p>
      </div>
      <Icon name="arrow-up-right" size={20} class="mt-1 hidden shrink-0 text-muted transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-accent-text md:block" />
    </article>
  )
}
