---
import { calendarLink, eventDateParts, type PartyEvent } from '../data/events';
import Icon from './Icon.astro';

interface Props {
  event: PartyEvent;
  detailed?: boolean;
}

const { event, detailed = false } = Astro.props;
const d = eventDateParts(event.date);
const time = event.start ? `${event.start}${event.end ? ` to ${event.end}` : ''}` : null;
---

<article class="flex gap-5">
  <div class="flex w-16 shrink-0 flex-col items-center overflow-hidden rounded-[0.9rem] border border-line bg-card text-center">
    <span class="w-full bg-accent py-1 text-xs font-bold uppercase tracking-wide text-white">{d.month}</span>
    <span class="py-2 font-display text-[1.75rem] font-extrabold leading-none [font-stretch:85%]">{d.day}</span>
  </div>
  <div class="min-w-0 flex-1">
    <h3 class="font-sans text-lg font-bold leading-snug tracking-normal">
      {event.title}
      {import.meta.env.DEV && event.sample && <span class="ml-1 rounded-full bg-paper-2 px-2 py-0.5 align-middle text-xs font-semibold text-muted">Sample</span>}
    </h3>
    <p class="mt-1 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-muted">
      <span>{d.weekday}{time && `, ${time}`}</span>
      <span class="inline-flex items-center gap-1"><Icon name="map-pin" size={14} />{event.venue}</span>
    </p>
    {
      detailed && (
        <>
          <p class="mt-3 max-w-[60ch] text-ink-2">{event.description}</p>
          <a href={calendarLink(event)} target="_blank" rel="noopener" class="arrow-link mt-3 text-sm">
            <Icon name="calendar-plus" size={18} /> Add to Google Calendar
          </a>
        </>
      )
    }
  </div>
</article>
