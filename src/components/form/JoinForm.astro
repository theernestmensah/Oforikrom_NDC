---
import { areas, zoneName } from '../../data/areas';
import Field from './Field.astro';
import FormShell from './FormShell.astro';

const areaOptions = [
  ...areas.map((a) => ({ value: a.id, label: a.name, group: `${zoneName(a.zone)} zonal council` })),
  { value: 'not-sure', label: 'Not sure' },
  { value: 'outside', label: 'I live outside Oforikrom' },
];

const roles = [
  { value: 'polling-agent', label: 'Polling station agent' },
  { value: 'canvassing', label: 'Door-to-door canvassing' },
  { value: 'communications', label: 'Communications and social media' },
  { value: 'events', label: 'Events and logistics' },
  { value: 'womens-wing', label: "Women's Wing" },
  { value: 'youth-tein', label: 'Youth Wing or TEIN' },
  { value: 'zongo-caucus', label: 'Zongo Caucus' },
  { value: 'professional', label: 'Professional skills (legal, health, IT)' },
];
---

<FormShell id="join-form" subject="New sign-up from the NDC Oforikrom website" submitLabel="Send my details" successTitle="You're in. Akwaaba!">
  <div class="grid gap-6 sm:grid-cols-2">
    <Field name="name" label="Full name" required autocomplete="name" class="sm:col-span-2" />
    <Field name="phone" label="Phone or WhatsApp number" type="tel" inputmode="tel" required autocomplete="tel" help="We'll use this to connect you with your branch." />
    <Field name="area" label="Electoral area" as="select" options={areaOptions} required />
    <Field name="station" label="Polling station" help="The name or code on your voter ID card, if you know it." class="sm:col-span-2" />
  </div>

  <fieldset class="grid gap-3" data-required-group>
    <legend class="field-label mb-3">Membership</legend>
    <div class="grid gap-3 sm:grid-cols-2">
      <label class="check">
        <input type="radio" name="membership" value="new" data-display="I want to become a member" required />
        <span>I want to become a member</span>
      </label>
      <label class="check">
        <input type="radio" name="membership" value="existing" data-display="I am already a member" />
        <span>I am already a member</span>
      </label>
    </div>
    <p class="field-error" data-error-for="membership" hidden></p>
  </fieldset>

  <fieldset class="grid gap-3">
    <legend class="field-label mb-1">I can help with <span class="font-normal text-muted">(optional)</span></legend>
    <p class="field-help mb-1">Tick any that interest you.</p>
    <div class="grid gap-3 sm:grid-cols-2">
      {
        roles.map((r) => (
          <label class="check">
            <input type="checkbox" name="roles" value={r.value} data-display={r.label} />
            <span>{r.label}</span>
          </label>
        ))
      }
    </div>
  </fieldset>

  <div class="grid gap-2">
    <label class="check border-transparent bg-paper-2 hover:border-transparent">
      <input type="checkbox" name="consent" value="yes" required />
      <span class="text-[0.95rem] text-ink-2">I agree that NDC Oforikrom may contact me about party membership and activities.</span>
    </label>
    <p class="field-error" data-error-for="consent" hidden></p>
  </div>
</FormShell>
