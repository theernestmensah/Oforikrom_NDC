---
/**
 * Wraps a form with submission handling. Submissions go to the form endpoint
 * in src/data/site.ts if one is set; otherwise WhatsApp opens with the details.
 */
import { site } from '../../data/site';
import Icon from '../Icon.astro';

interface Props {
  id: string;
  /** First line of the WhatsApp message / email subject. */
  subject: string;
  submitLabel: string;
  successTitle: string;
  class?: string;
}

const { id, subject, submitLabel, successTitle, class: className = '' } = Astro.props;
const connected = Boolean(site.forms.endpoint || site.contact.whatsapp);
---

<div class={className}>
  <form
    id={id}
    novalidate
    data-ndc-form
    data-endpoint={site.forms.endpoint}
    data-whatsapp={site.contact.whatsapp}
    data-subject={subject}
    class="grid gap-6"
  >
    <slot />
    <p data-form-error role="alert" class="rounded-[0.9rem] bg-paper-2 px-4 py-3 font-semibold text-accent-text" hidden></p>
    <div class="flex flex-wrap items-center gap-4">
      <button type="submit" class="btn btn-primary" data-submit>
        {submitLabel}
        <Icon name="arrow-right" class="btn-arrow" />
      </button>
      {
        import.meta.env.DEV && !connected && (
          <p class="text-sm text-muted">Developer note: set forms.endpoint or contact.whatsapp in src/data/site.ts to receive submissions.</p>
        )
      }
    </div>
  </form>

  <div data-form-success hidden tabindex="-1" class="rounded-box border border-line bg-card p-8 text-center outline-none">
    <span class="mx-auto grid size-14 place-items-center rounded-full bg-go-soft text-go-text">
      <Icon name="check-circle" size={30} />
    </span>
    <h3 class="mt-5 text-2xl font-bold">{successTitle}</h3>
    <p class="mx-auto mt-2 max-w-[44ch] text-ink-2" data-success-text>Thank you. Someone from the constituency office will be in touch.</p>
    <a href="#" target="_blank" rel="noopener" class="btn btn-outline mt-6" data-whatsapp-retry hidden>
      <Icon name="whatsapp-logo" /> Open WhatsApp again
    </a>
  </div>
</div>

<script>
  const PHONE = /^(\+?233|0)[235]\d{8}$/;

  function labelFor(form: HTMLFormElement, name: string) {
    const el = form.querySelector<HTMLElement>(`[data-label-for="${name}"]`) ?? form.querySelector<HTMLLabelElement>(`label[for="f-${name}"]`);
    return (el?.dataset.labelText ?? el?.textContent ?? name).replace('(optional)', '').trim();
  }

  function setError(form: HTMLFormElement, name: string, message: string | null) {
    const error = form.querySelector<HTMLElement>(`[data-error-for="${name}"]`);
    const fields = form.querySelectorAll<HTMLInputElement>(`[name="${name}"]`);
    fields.forEach((f) => (message ? f.setAttribute('aria-invalid', 'true') : f.removeAttribute('aria-invalid')));
    if (error) {
      error.hidden = !message;
      error.textContent = message ?? '';
    }
  }

  function validate(form: HTMLFormElement) {
    const names = new Set([...form.querySelectorAll<HTMLInputElement>('[name]')].map((f) => f.name));
    let firstInvalid: HTMLElement | null = null;

    for (const name of names) {
      const fields = [...form.querySelectorAll<HTMLInputElement>(`[name="${name}"]`)];
      const first = fields[0]!;
      const isGroup = first.type === 'radio' || first.type === 'checkbox';
      const required = fields.some((f) => f.required) || first.closest('[data-required-group]') !== null;
      let message: string | null = null;

      if (isGroup) {
        if (required && !fields.some((f) => f.checked)) {
          message = first.type === 'checkbox' && fields.length === 1 ? 'Please tick this box to continue.' : 'Please choose an option.';
        }
      } else {
        const value = first.value.trim();
        const label = labelFor(form, name);
        if (required && !value) message = `Please enter your ${label.charAt(0).toLowerCase()}${label.slice(1)}.`;
        else if (value && first.type === 'tel' && !PHONE.test(value.replace(/[\s-]/g, ''))) message = 'Enter a Ghana number, for example 024 123 4567.';
        else if (value && first.type === 'email' && !/^\S+@\S+\.\S+$/.test(value)) message = 'Enter an email address like name@example.com.';
        if (first.tagName === 'SELECT' && required && !value) message = 'Please choose an option.';
      }

      setError(form, name, message);
      if (message && !firstInvalid) firstInvalid = first;
    }

    firstInvalid?.focus();
    return !firstInvalid;
  }

  function summary(form: HTMLFormElement) {
    const data = new FormData(form);
    const lines: string[] = [];
    for (const name of new Set(data.keys())) {
      if (name === 'consent') continue;
      const values = data.getAll(name).map(String).filter(Boolean);
      if (!values.length) continue;
      const field = form.querySelector<HTMLElement>(`[name="${name}"]`);
      const label = field?.closest('fieldset')?.querySelector('legend')?.textContent?.trim() ?? labelFor(form, name);
      const display = values.map((v) => {
        if (field instanceof HTMLSelectElement) return field.querySelector<HTMLOptionElement>(`option[value="${CSS.escape(v)}"]`)?.textContent ?? v;
        const option = form.querySelector<HTMLInputElement>(`[name="${name}"][value="${CSS.escape(v)}"]`);
        return option?.dataset.display ?? v;
      });
      lines.push(`${label.replace('(optional)', '').trim()}: ${display.join(', ')}`);
    }
    return lines;
  }

  document.querySelectorAll<HTMLFormElement>('form[data-ndc-form]').forEach((form) => {
    const wrapper = form.parentElement!;
    const success = wrapper.querySelector<HTMLElement>('[data-form-success]')!;
    const formError = form.querySelector<HTMLElement>('[data-form-error]')!;
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const { endpoint, whatsapp, subject } = form.dataset;

    form.addEventListener('change', (e) => {
      const target = e.target as HTMLInputElement;
      if (target.name && target.getAttribute('aria-invalid') === 'true') setError(form, target.name, null);
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      formError.hidden = true;
      if (!validate(form)) return;

      const showSuccess = (text?: string) => {
        form.hidden = true;
        success.hidden = false;
        if (text) success.querySelector('[data-success-text]')!.textContent = text;
        success.focus();
      };

      if (endpoint) {
        submit.disabled = true;
        const original = submit.innerHTML;
        submit.textContent = 'Sending...';
        try {
          const body = new FormData(form);
          body.append('_subject', subject ?? 'Website form');
          const res = await fetch(endpoint, { method: 'POST', body, headers: { Accept: 'application/json' } });
          if (!res.ok) throw new Error(String(res.status));
          showSuccess();
        } catch {
          formError.textContent = 'Something went wrong sending your details. Please check your connection and try again.';
          formError.hidden = false;
        } finally {
          submit.disabled = false;
          submit.innerHTML = original;
        }
        return;
      }

      if (whatsapp) {
        const text = [subject, '', ...summary(form)].join('\n');
        const url = `https://wa.me/${whatsapp}?text=${encodeURIComponent(text)}`;
        window.open(url, '_blank', 'noopener');
        const retry = success.querySelector<HTMLAnchorElement>('[data-whatsapp-retry]')!;
        retry.href = url;
        retry.hidden = false;
        showSuccess('WhatsApp has opened with your details filled in. Press send in WhatsApp to finish.');
        return;
      }

      formError.textContent = 'This form is not connected yet. Please contact the constituency office directly.';
      formError.hidden = false;
    });
  });
</script>
