---
import EventItem from '../components/EventItem.astro';
import Icon from '../components/Icon.astro';
import PageHero from '../components/PageHero.astro';
import { pastEvents, upcomingEvents } from '../data/events';
import { site } from '../data/site';
import Base from '../layouts/Base.astro';

const upcoming = upcomingEvents();
const past = pastEvents().slice(0, 8);
---

<Base title="Events" description="Upcoming meetings, trainings and community events of the NDC in Oforikrom Constituency.">
  <PageHero crumb="Events" title="Events" intro="Meetings, trainings, campus drives and community events across Oforikrom. All members and supporters are welcome unless stated." variant={0} />

  <section class="wrap py-16 lg:py-24">
    <div class="grid gap-14 lg:grid-cols-12">
      <div class="lg:col-span-8">
        <h2 class="display-md" data-reveal>Coming up</h2>
        {
          upcoming.length > 0 ? (
            <ul class="mt-8 divide-y divide-line border-y border-line">
              {upcoming.map((e, i) => (
                <li class="py-8" data-reveal style={`--d:${i % 3}`}>
                  <EventItem event={e} detailed />
                </li>
              ))}
            </ul>
          ) : (
            <div class="mt-8 rounded-box border border-dashed border-line-strong p-10 text-center" data-reveal>
              <Icon name="calendar-blank" size={40} class="mx-auto text-muted" />
              <p class="mt-4 text-xl font-semibold">No events scheduled right now.</p>
              <p class="mx-auto mt-2 max-w-[42ch] text-ink-2">New dates are shared with branches first and posted here. Check back soon, or ask your branch executives.</p>
            </div>
          )
        }

        {
          past.length > 0 && (
            <>
              <h2 class="display-md mt-20">Past events</h2>
              <ul class="mt-8 grid gap-8 sm:grid-cols-2">
                {past.map((e) => (
                  <li class="opacity-80">
                    <EventItem event={e} />
                  </li>
                ))}
              </ul>
            </>
          )
        }
      </div>

      <aside class="lg:col-span-4">
        <div class="rounded-box bg-ndc-black p-8 text-ndc-white lg:sticky lg:top-28" data-reveal style="--d:1">
          <Icon name="megaphone" size={34} class="text-ndc-white/90" />
          <h2 class="mt-5 text-2xl font-bold">Organising something in your area?</h2>
          <p class="mt-3 text-ndc-white/80">Branch executives can send event details to the constituency office to have them listed here.</p>
          <a href="/contact" class="btn btn-light mt-7">Contact us</a>
          {
            site.socials.whatsappChannel && (
              <a href={site.socials.whatsappChannel} target="_blank" rel="noopener" class="mt-5 flex items-center gap-2 font-semibold text-ndc-white underline underline-offset-4">
                <Icon name="whatsapp-logo" /> Follow our WhatsApp Channel
              </a>
            )
          }
        </div>
      </aside>
    </div>
  </section>
</Base>
