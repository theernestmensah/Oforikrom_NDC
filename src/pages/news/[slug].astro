---
import { getCollection, render } from 'astro:content';
import Icon from '../../components/Icon.astro';
import JoinCta from '../../components/JoinCta.astro';
import Kente from '../../components/Kente.astro';
import NewsCard from '../../components/NewsCard.astro';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const posts = await getCollection('news');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, date, excerpt, tag, image, imageAlt } = post.data;

const words = (post.body ?? '').split(/\s+/).filter(Boolean).length;
const minutes = Math.max(1, Math.round(words / 200));
const dateLabel = date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const url = new URL(Astro.url.pathname, Astro.site).toString();

const share = [
  { label: 'WhatsApp', icon: 'whatsapp-logo', href: `https://wa.me/?text=${encodeURIComponent(`${title} ${url}`)}` },
  { label: 'Facebook', icon: 'facebook-logo', href: `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}` },
  { label: 'X', icon: 'x-logo', href: `https://x.com/intent/post?text=${encodeURIComponent(title)}&url=${encodeURIComponent(url)}` },
];

const more = (await getCollection('news'))
  .filter((p) => p.id !== post.id)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 2);
---

<Base title={title} description={excerpt} type="article" image={image}>
  <article>
    <header class="wrap pb-10 pt-10 lg:pt-16">
      <div class="mx-auto max-w-3xl">
        <nav aria-label="Breadcrumb" class="rise text-sm text-muted">
          <a href="/" class="hover:text-ink">Home</a>
          <span class="mx-2" aria-hidden="true">/</span>
          <a href="/news" class="hover:text-ink">News</a>
        </nav>
        <p class="rise mt-8 text-sm text-muted" style="--d:1">
          <span class="font-semibold text-accent-text">{tag}</span>
          <span class="mx-1.5" aria-hidden="true">/</span>
          <time datetime={date.toISOString()}>{dateLabel}</time>
          <span class="mx-1.5" aria-hidden="true">/</span>
          {minutes} min read
        </p>
        <h1 class="rise display-lg mt-4" style="--d:2">{title}</h1>
        <p class="rise mt-6 text-xl leading-relaxed text-ink-2" style="--d:3">{excerpt}</p>
      </div>
    </header>

    {
      image ? (
        <figure class="wrap">
          <img src={image} alt={imageAlt ?? ''} class="mx-auto aspect-[16/9] w-full max-w-5xl rounded-box object-cover" />
        </figure>
      ) : (
        <Kente variant={0} class="h-4" />
      )
    }

    <div class="wrap py-12 lg:py-16">
      <div class="mx-auto max-w-3xl">
        <div class="prose-ndc">
          <Content />
        </div>

        <aside class="mt-14 flex flex-wrap items-center gap-3 border-t border-line pt-8" aria-label="Share this article">
          <p class="mr-2 font-semibold">Share</p>
          {
            share.map((s) => (
              <a href={s.href} target="_blank" rel="noopener" class="btn btn-outline btn-sm">
                <Icon name={s.icon} size={18} /> {s.label}
              </a>
            ))
          }
          <button type="button" class="js-only btn btn-outline btn-sm" data-copy-link={url}>
            <Icon name="link" size={18} /> <span data-copy-label>Copy link</span>
          </button>
        </aside>
      </div>
    </div>
  </article>

  {
    more.length > 0 && (
      <section class="border-t border-line bg-paper-2 py-16">
        <div class="wrap">
          <h2 class="display-md">More news</h2>
          <ul class="mt-8 grid gap-x-12 md:grid-cols-2">
            {more.map((p, i) => (
              <li class="border-t border-line py-7">
                <NewsCard post={p} variant={i + 1} />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <JoinCta />
</Base>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy-link]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const label = btn.querySelector('[data-copy-label]');
      try {
        await navigator.clipboard.writeText(btn.dataset.copyLink ?? location.href);
        if (label) label.textContent = 'Link copied';
      } catch {
        if (label) label.textContent = 'Copy failed';
      }
      setTimeout(() => label && (label.textContent = 'Copy link'), 2500);
    });
  });
</script>
